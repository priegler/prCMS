{
  "name": "@inlinecms/core",
  "version": "0.2.0",
  "type": "module",
  "description": "Source-first inline editing: resolution, patches, publishing and agents",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    }
  },
  "bin": {
    "inlinecms": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@astrojs/compiler": "^2.12.0",
    "diff": "^8.0.0",
    "entities": "^6.0.0",
    "glob": "^11.0.0",
    "picomatch": "^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0",
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "playwright": "^1.50.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
