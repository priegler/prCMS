{
  "name": "@inlinecms/transform",
  "version": "0.2.0",
  "type": "module",
  "description": "Development-only source locators for Next, Vite, webpack, rspack, esbuild and Astro",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./loader": "./dist/loader.cjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@inlinecms/core": "workspace:*",
    "magic-string": "^0.30.0",
    "unplugin": "^2.3.0",
    "@astrojs/compiler": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0"
  }
}
